@model Bookstore.ViewModels.BookAuthorViewModel

@{
    ViewData["Title"] = "Edit Book";
}

<div class="row">
    <div class="col-md-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Book" asp-action="Index">Books</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Book</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="text-white mb-0">Edit Book: @Model.Title</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="BookId" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="form-group">
                        <label asp-for="Title" class="control-label font-weight-bold">Book Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="control-label font-weight-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter book description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AuthorId" class="control-label font-weight-bold">Author</label>
                        <select asp-for="AuthorId" class="form-control"
                                asp-items="@(new SelectList(Model.Authors,"Id","FullName"))"></select>
                        <span asp-validation-for="AuthorId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="control-label font-weight-bold">Book Cover Image</label>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="current-image">
                                    <p class="mb-2">Current Image:</p>
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="~/uploads/@Model.ImageUrl" class="img-thumbnail" style="max-height: 200px;" />
                                    }
                                    else
                                    {
                                        <div class="py-5 bg-light text-center">
                                            <i class="fas fa-image fa-3x text-muted"></i>
                                            <p class="mt-2 text-muted">No image available</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="new-image">
                                    <p class="mb-2">New Image Preview:</p>
                                    <div id="imagePreview" style="display: none;">
                                        <img id="preview" src="#" alt="Preview" class="img-thumbnail" style="max-height: 200px;" />
                                    </div>
                                    <div id="noPreview" class="py-5 bg-light text-center">
                                        <i class="fas fa-upload fa-3x text-muted"></i>
                                        <p class="mt-2 text-muted">Upload to see preview</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="customFile" name="File" asp-for="File" onchange="displayFileName()" accept="image/*">
                            <label class="custom-file-label" for="customFile" id="fileLabel">Choose new image file</label>
                        </div>
                        <small class="form-text text-muted">Upload a new cover image for the book (JPG, PNG, GIF)</small>
                        <span asp-validation-for="File" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-4">
                        <label class="control-label font-weight-bold">Book PDF File</label>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="current-pdf">
                                    <p class="mb-2">Current PDF:</p>
                                    @if (!string.IsNullOrEmpty(Model.PdfUrl))
                                    {
                                        <div class="card">
                                            <div class="card-body">
                                                <h5 class="card-title"><i class="fas fa-file-pdf text-danger mr-2"></i> @Model.PdfUrl</h5>
                                                <a href="~/uploads/pdfs/@Model.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye mr-1"></i> View PDF
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="py-5 bg-light text-center">
                                            <i class="fas fa-file-pdf fa-3x text-muted"></i>
                                            <p class="mt-2 text-muted">No PDF available</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="new-pdf">
                                    <p class="mb-2">New PDF:</p>
                                    <div id="pdfPreview" style="display: none;">
                                        <div class="card">
                                            <div class="card-body">
                                                <h5 class="card-title"><i class="fas fa-file-pdf text-danger mr-2"></i> <span id="pdfName"></span></h5>
                                                <p class="card-text text-success"><i class="fas fa-check-circle mr-1"></i> PDF selected successfully</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="noPdfPreview" class="py-5 bg-light text-center">
                                        <i class="fas fa-upload fa-3x text-muted"></i>
                                        <p class="mt-2 text-muted">Upload to select new PDF</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="pdfFile" name="PdfFile" asp-for="PdfFile" onchange="displayPdfFileName()" accept=".pdf">
                            <label class="custom-file-label" for="pdfFile" id="pdfFileLabel">Choose new PDF file</label>
                        </div>
                        <small class="form-text text-muted">Upload a new PDF version of the book (PDF only)</small>
                        <span asp-validation-for="PdfFile" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save mr-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg ml-2">
                            <i class="fas fa-arrow-left mr-2"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="text-white mb-0">Book Information</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <i class="fas fa-hashtag text-primary mr-2"></i>
                        <strong>Book ID:</strong> @Model.BookId
                    </li>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <li class="list-group-item">
                            <i class="fas fa-image text-primary mr-2"></i>
                            <strong>Image File:</strong> @Model.ImageUrl
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="text-white mb-0">Tips for Editing</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <i class="fas fa-info-circle text-primary mr-2"></i>
                        Leave the image field empty to keep the current image
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-image text-primary mr-2"></i>
                        Upload a new image to replace the current one
                    </li>
                    <li class="list-group-item">
                        <i class="fas fa-text-height text-primary mr-2"></i>
                        Provide a detailed description for better visibility
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_Validation" />
    <script>
        function displayFileName() {
            var input = document.getElementById('customFile');
            var label = document.getElementById('fileLabel');
            var preview = document.getElementById('preview');
            var imagePreview = document.getElementById('imagePreview');
            var noPreview = document.getElementById('noPreview');

            if (input.files && input.files[0]) {
                var fileName = input.files[0].name;
                label.innerHTML = fileName;

                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    imagePreview.style.display = 'block';
                    noPreview.style.display = 'none';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function displayPdfFileName() {
            var input = document.getElementById('pdfFile');
            var label = document.getElementById('pdfFileLabel');
            var pdfName = document.getElementById('pdfName');
            var pdfPreview = document.getElementById('pdfPreview');
            var noPdfPreview = document.getElementById('noPdfPreview');

            if (input.files && input.files[0]) {
                var fileName = input.files[0].name;
                label.innerHTML = fileName;
                pdfName.textContent = fileName;
                pdfPreview.style.display = 'block';
                noPdfPreview.style.display = 'none';
            }
        }
    </script>
}
