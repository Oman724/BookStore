@model IEnumerable<Bookstore.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <h1 class="page-title">Discover Amazing Books</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle mr-2"></i> Add New Book
    </a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="empty-state">
                <i class="fas fa-book fa-5x mb-4" style="color: var(--primary-color);"></i>
                <h3>No books found</h3>
                <p class="text-muted">Start by adding your first book to the collection.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus-circle mr-2"></i> Add First Book
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-0 text-white">@item.Title</h5>
                    </div>
                    <div class="text-center p-3 book-cover-container" style="overflow: hidden;">
                        @if (item.ImageUrl != null)
                        {
                            <img src="~/uploads/@item.ImageUrl" class="card-img-top book-img" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="py-5 bg-light text-center book-placeholder">
                                <i class="fas fa-book fa-4x text-muted"></i>
                                <p class="mt-3 text-muted">No Cover Image</p>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="book-info mb-3">
                            <span class="badge badge-pill" style="background: linear-gradient(to right, var(--primary-color), var(--secondary-color)); color: white;">
                                Book #@item.Id
                            </span>
                            <span class="badge badge-pill badge-light">
                                <i class="fas fa-user mr-1"></i> @(item.Author != null ? item.Author.FullName : "Unknown Author")
                            </span>
                            @if (!string.IsNullOrEmpty(item.PdfUrl))
                            {
                                <span class="badge badge-pill badge-danger">
                                    <i class="fas fa-file-pdf mr-1"></i> PDF Available
                                </span>
                            }
                        </div>
                        <p class="card-text">@(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="btn-group w-100">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" data-toggle="tooltip" title="Edit this book">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" data-toggle="tooltip" title="View details">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" data-toggle="tooltip" title="Delete this book">
                                <i class="fas fa-trash-alt"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_Validation" />
    <script>
        // Add animation to cards
        $(document).ready(function() {
            $('.card').each(function(i) {
                $(this).delay(i * 100).animate({'opacity': 1}, 500);
            });
        });
    </script>
    <style>
        .card {
            opacity: 0;
        }

        .book-cover-container {
            height: 250px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .book-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .badge {
            padding: 8px 15px;
            margin-right: 5px;
            margin-bottom: 5px;
            font-weight: 500;
        }
    </style>
}